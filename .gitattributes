# Enforce LF line endings for all text files in the repo.
# This prevents cross-platform dirtying when tools like cargo
# rewrite files with LF on Windows (where core.autocrlf=true
# would otherwise expect CRLF in the working tree).
* text=auto eol=lf

# Ensure these stay binary (never normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Preserve these byte-for-byte legacy backend snapshot files while excluding
# their pre-existing whitespace from migration-wide `git diff --check` output.
backend/.coveragerc -whitespace
backend/src/ldaca_wordflow/resources/ldaca_tabular_configs/corpora/name,hdl10.26180~23961609.json -whitespace
