  "scripts": {
    "dev": "vite",
    "dev:tauri": "vite --host 0.0.0.0 --port 3001 --strictPort",
    "build": "tsc --noEmit && vite build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck:tooling && pnpm test && pnpm knip && pnpm build && pnpm docs:check && pnpm versions:check",
    "preview": "vite preview",
    "openapi:schema": "cd ../backend && uv run python scripts/export_openapi.py --output ../frontend/openapi/ldaca-wordflow.openapi.json",
    "openapi:generate": "pnpm openapi:schema && openapi-ts -f openapi.config.ts",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.{ts,tsx}' vite.config.ts openapi.config.ts --max-warnings=0",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json --noEmit",
    "knip": "knip",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "docs:check": "node --experimental-strip-types scripts/check-docs-drift.mjs",
    "versions:check": "node ../scripts/check-versions.mjs && node --test ../scripts/check-versions.test.mjs ../scripts/prepare-backend-runtime.test.mjs scripts/stage-backend-runtime.test-node.mjs",
    "tauri": "tauri",
    "clean": "cd src-tauri && cargo clean",
    "prepare:backend-runtime": "node ../scripts/prepare-backend-runtime.mjs",
    "desktop:dev": "pnpm prepare:backend-runtime && tauri dev",
    "desktop:build:mac": "pnpm prepare:backend-runtime && CI=true tauri build --bundles app,dmg",
    "desktop:build:windows": "pnpm prepare:backend-runtime && tauri build"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "^2.4.16",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.98.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "knip": "^6.16.1",
    "msw": "2.14.6",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
