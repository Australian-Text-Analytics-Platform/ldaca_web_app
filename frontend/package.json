    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-joyride": "^3.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
