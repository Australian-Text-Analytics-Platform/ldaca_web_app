{
  "name": "ldaca_wordflow_frontend",
  "version": "0.7.4",
  "description": "LDaCA Wordflow Frontend - React application for text analytics and corpus analysis",
  "type": "module",
  "private": true,
  "homepage": ".",
  "repository": {
    "type": "git",
    "url": "https://github.com/Australian-Text-Analytics-Platform/ldaca-wordflow.git",
    "directory": "ldaca_wordflow/frontend"
  },
  "keywords": [
    "ldaca",
    "text-analytics",
    "corpus-analysis",
    "linguistics",
    "react",
    "vite"
  ],
  "author": "Australian Text Analytics Platform",
  "license": "MIT",
  "dependencies": {
    "@codemirror/view": "^6.43.9",
    "@dagrejs/dagre": "^3.1.1",
    "@mediapipe/tasks-text": "^1.0.1",
    "@react-oauth/google": "^0.13.5",
    "@sentry/react": "^10.71.0",
    "@tanstack/react-query": "^5.102.2",
    "@tanstack/react-query-devtools": "^5.102.2",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@uiw/react-codemirror": "^4.25.11",
    "@visx/text": "^4.0.0",
    "@visx/wordcloud": "^4.0.0",
    "@xyflow/react": "^12.11.3",
    "apache-arrow": "^21.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "immer": "^11.1.18",
    "jszip": "^3.10.1",
    "katex": "^0.18.4",
    "lucide-react": "^1.34.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-joyride": "^3.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "stopword": "^3.1.5",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "dev": "vite",
    "dev:tauri": "vite --host 0.0.0.0 --port 3001 --strictPort",
    "build": "pnpm theme:check && pnpm theme:audit && tsc --noEmit && vite build && node scripts/verify-build.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck:tooling && pnpm test && pnpm knip && pnpm build && pnpm docs:check && pnpm versions:check",
    "theme:generate": "node scripts/generate-vscode-theme.mjs",
    "theme:check": "node scripts/generate-vscode-theme.mjs --check",
    "theme:audit": "node scripts/check-theme-contract.mjs",
    "preview": "vite preview",
    "openapi:schema": "cd ../backend && uv run python scripts/export_openapi.py --output ../frontend/openapi/ldaca-wordflow.openapi.json",
    "openapi:generate": "pnpm openapi:schema && openapi-ts -f openapi.config.ts",
    "test": "vitest run && node --test scripts/verify-build.test-node.mjs",
    "lint": "eslint 'src/**/*.{ts,tsx}' vite.config.ts openapi.config.ts --max-warnings=0",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json --noEmit",
    "knip": "knip",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "docs:check": "node --experimental-strip-types scripts/check-docs-drift.mjs",
    "docs:sync-publish": "node --experimental-strip-types scripts/sync-published-docs.mjs",
    "versions:check": "node ../scripts/check-versions.mjs && node --test ../scripts/check-versions.test.mjs ../scripts/prepare-backend-runtime.test.mjs scripts/stage-backend-runtime.test-node.mjs",
    "tauri": "tauri",
    "clean": "cd src-tauri && cargo clean",
    "clean:desktop:mac-bundles": "node scripts/clean-desktop-mac-bundles.mjs",
    "prepare:backend-runtime": "node ../scripts/prepare-backend-runtime.mjs",
    "desktop:dev": "pnpm prepare:backend-runtime && tauri dev",
    "desktop:build:mac": "pnpm clean:desktop:mac-bundles && pnpm prepare:backend-runtime && CI=true tauri build --bundles app,dmg --target aarch64-apple-darwin",
    "desktop:build:windows": "pnpm prepare:backend-runtime && tauri build"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@biomejs/biome": "^2.5.10",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/eslint-plugin-query": "^5.102.2",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "msw": "2.15.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
