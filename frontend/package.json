    "@visx/wordcloud": "^4.0.1-alpha.0",
    "@xyflow/react": "^12.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "immer": "^11.1.4",
