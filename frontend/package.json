{
  "name": "ldaca_web_app_frontend",
  "version": "0.2.8",
  "description": "LDaCA Web App Frontend - React application for text analytics and corpus analysis",
  "type": "module",
  "private": true,
  "homepage": ".",
  "repository": {
    "type": "git",
    "url": "https://github.com/Australian-Text-Analytics-Platform/ldaca_web_app.git",
    "directory": "ldaca_web_app/frontend"
  },
  "keywords": [
    "ldaca",
    "text-analytics",
    "corpus-analysis",
    "linguistics",
    "react",
    "vite"
  ],
  "author": "Australian Text Analytics Platform",
  "license": "MIT",
  "bin": {
    "ldaca_web_app_frontend": "./bin/cli.js",
    "ldaca-frontend": "./bin/cli.js"
  },
  "files": [
    "bin",
    "build",
    "README.md"
  ],
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
