# LDaCA Frontend Environment Variables
# All variables are OPTIONAL with sensible defaults
# The frontend does NOT require a .env file to run

# Google OAuth Configuration (only needed for multi-user mode)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Frontend Dev Server Configuration
# Port for the frontend dev server (default: 3000)
# This variable is used by Vite's dev server (Node.js side)
# Usage: FRONTEND_PORT=4000 npm run dev
# FRONTEND_PORT=3000

# Backend API Configuration
# Backend port (default: 8001)
# This variable is exposed to browser code (hence VITE_ prefix)
# Frontend will connect to http://localhost:${VITE_BACKEND_PORT}/api in dev mode
# VITE_BACKEND_PORT=8001

# Full backend API URL override (optional, takes precedence over VITE_BACKEND_PORT)
# Use this if backend is on a different host or has custom path
# VITE_BACKEND_API_BASE=http://localhost:8001/api

# Feature Flags (optional)
# VITE_ENABLE_DEBUG=false

# Docs registry (optional)
# Root URL of the externally-hosted docs site. The app derives its matching
# minor tag (for example, app 0.7.1 reads v0.7/registry.json + markdown).
# When unset/empty, the app uses its bundled fallback registry only.
# Production example: VITE_DOCS_ORIGIN=https://australian-text-analytics-platform.github.io/ldaca-wordflow-docs
# Dev override: put this in `.env.local` pointing at a local file server.
# VITE_DOCS_ORIGIN=

# Sentry error monitoring (optional)
# Leave empty to disable — errors will only be logged to console.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
